# Copie para apps/api-java/.env e preencha os valores reais.
# DATABASE_PASSWORD deve ser igual ao POSTGRES_PASSWORD do .env raiz
# (usado pelo serviço bruno_postgres no docker-compose.yml).

PORT=3001
SPRING_PROFILES_ACTIVE=prod

# Host "bruno_postgres" é o nome do serviço no docker-compose (rede interna).
DATABASE_URL=jdbc:postgresql://bruno_postgres:5432/bruno_gusmao_java
DATABASE_USERNAME=brunogusmao
DATABASE_PASSWORD=

# Gerar com: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_DAYS=7
JWT_COOKIE_NAME=access_token
# Sem isso o cookie do login fica preso a api.brunogusmao.dev e o front
# (brunogusmao.dev) nunca recebe ele — login "funciona" mas cai de volta no /login.
COOKIE_DOMAIN=brunogusmao.dev

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Um ou mais e-mails separados por vírgula (sem espaços obrigatórios)
ALLOWED_EMAILS=

WEB_URL=https://brunogusmao.dev
