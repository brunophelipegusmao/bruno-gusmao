# syntax=docker/dockerfile:1
FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@10.33.4 --activate

# ── build ────────────────────────────────────────────────────────────────────
FROM base AS build
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
WORKDIR /app/apps/api
RUN ./node_modules/.bin/nest build && ls dist/main.js
WORKDIR /app
RUN pnpm --filter api deploy --prod /deploy/api \
    && cp -r apps/api/dist /deploy/api/dist

# ── runner ───────────────────────────────────────────────────────────────────
FROM node:22-slim AS runner
ENV NODE_ENV=production
ENV PORT=3001
RUN groupadd -g 1001 nodejs && useradd -u 1001 -g nodejs -m nestjs
WORKDIR /app
COPY --from=build --chown=nestjs:nodejs /deploy/api .
USER nestjs
EXPOSE 3001
HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD node -e "fetch('http://localhost:3001/api').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/main.js"]
