# syntax=docker/dockerfile:1
FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@10.33.4 --activate

# ── build ────────────────────────────────────────────────────────────────────
FROM base AS build
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
WORKDIR /app/apps/api
# Roda o build sem falhar para poder inspecionar o resultado
RUN ./node_modules/.bin/nest build 2>&1 || true
# Mostra tudo o que foi gerado — encontra o main.js independente de onde estiver
RUN echo "=== ls apps/api ===" && ls -la /app/apps/api/ \
    && echo "=== dist (se existir) ===" && ls -la /app/apps/api/dist/ 2>/dev/null || echo "SEM dist" \
    && echo "=== find main.js em todo /app ===" && find /app -name "main.js" 2>/dev/null \
    && echo "=== find *.js em dist ===" && find /app -path "*/dist/*.js" 2>/dev/null | head -20
